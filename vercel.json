{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/api"
    },
    {
      "source": "/oauth/authorize/",
      "destination": "/api"
    },
    {
      "source": "/oauth/token",
      "destination": "/api"
    },
    {
      "source": "/oauth/token/",
      "destination": "/api"
    },
    {
      "source": "/oauth/register",
      "destination": "/api"
    },
    {
      "source": "/oauth/register/",
      "destination": "/api"
    },
    {
      "source": "/oauth/revoke",
      "destination": "/api"
    },
    {
      "source": "/oauth/revoke/",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/mcp/",
      "destination": "/api"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**",
      "maxDuration": 60
    }
  }
}