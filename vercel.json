{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/oauth/token",
      "destination": "/api"
    },
    {
      "source": "/oauth/token/",
      "destination": "/api"
    },
    {
      "source": "/oauth/register",
      "destination": "/api"
    },
    {
      "source": "/oauth/revoke",
      "destination": "/api"
    },
    {
      "source": "/mcp",
      "destination": "/api"
    },
    {
      "source": "/mcp/",
      "destination": "/api"
    },
    {
      "source": "/.well-known/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(dashboard|login|oauth/authorize|oauth/success|connections|profile)",
      "destination": "/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "client/dist/**",
      "maxDuration": 60
    }
  }
}