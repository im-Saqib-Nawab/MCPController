{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/oauth/authorize", "destination": "/api" },
    { "source": "/oauth/authorize/", "destination": "/api" },
    { "source": "/oauth/token", "destination": "/api" },
    { "source": "/oauth/token/", "destination": "/api" },
    { "source": "/oauth/register", "destination": "/api" },
    { "source": "/oauth/register/", "destination": "/api" },
    { "source": "/oauth/revoke", "destination": "/api" },
    { "source": "/oauth/revoke/", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/mcp/", "destination": "/api" },
    { "source": "/.well-known/:path*", "destination": "/api" },
    { "source": "/health", "destination": "/api" },
    {
      "source": "/((?!assets/|api(?:/|$)|oauth(?:/|$)|mcp(?:/|$)|\\.well-known(?:/|$)|health(?:/|$)).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
