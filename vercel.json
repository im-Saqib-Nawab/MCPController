{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|api(?:/|$)|oauth(?:/|$)|mcp(?:/|$)|\\.well-known(?:/|$)|health(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
