# Base development settings. Copy to .env and adjust locally.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/mcpcontroller
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

CSRF_ENABLED=true
OAUTH_DCR_ENABLED=true
PASSWORD_MAX_LENGTH=128

AUTH_CODE_TTL_SECONDS=600
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_SERVER_NAME=MCPController
MCP_SERVER_VERSION=1.0.0

LOG_LEVEL=debug
LOG_SLOW_REQUEST_MS=2000
METRICS_TOKEN=
SENTRY_DSN=
TEST_CENTER_ENABLED=true
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
FEATURE_FLAG_CACHE_TTL_MS=60000
SYNC_INDEXES_ON_STARTUP=true

# Credits & subscriptions
INITIAL_FREE_CREDITS=100
LOW_CREDIT_THRESHOLD=10
MONTHLY_PLAN_PRICE_CENTS=999
MONTHLY_PLAN_CREDITS=100
MONTHLY_PLAN_DURATION_DAYS=30
YEARLY_PLAN_PRICE_CENTS=9999
YEARLY_PLAN_CREDITS=1500
YEARLY_PLAN_DURATION_DAYS=365
PAYMENT_PROVIDER=dev
# - .env.development
# - .env.staging
# - .env.production
# Values in .env.${NODE_ENV} override the base .env file.
