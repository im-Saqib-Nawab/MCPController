NODE_ENV=development

# Express listens on this port. In production the host may override PORT.
PORT=3000

# Public URL of the React UI (login, consent, dashboard).
# Local:  http://localhost:5173
# Vercel: https://your-project.vercel.app  (same as API_URL)
APP_URL=http://localhost:5173

# Public URL of Express (API, OAuth token, MCP).
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app  (same as APP_URL)
API_URL=http://localhost:3000

# MongoDB connection string (local or Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/mcpcontroller

# Signs the HTTP-only login cookie (user dashboard / consent session).
JWT_SECRET=replace-with-a-long-random-secret

# Reserved for cookie signing if you extend the app. Keep it set.
SESSION_SECRET=replace-with-a-long-random-secret

# How long a logged-in dashboard session lasts.
JWT_EXPIRES_IN=7d

# OAuth authorization codes expire quickly (seconds).
AUTH_CODE_TTL_SECONDS=120

# Access tokens expire (seconds). ChatGPT can refresh them.
ACCESS_TOKEN_TTL_SECONDS=3600

# Refresh tokens expire (seconds).
REFRESH_TOKEN_TTL_SECONDS=2592000

MCP_SERVER_NAME=MCPController
MCP_SERVER_VERSION=1.0.0
