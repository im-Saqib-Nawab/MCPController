# Vercel Preview / canary-target overrides.
# In Vercel: Project -> Settings -> Environment Variables -> Preview
#
# CRITICAL: APP_URL and API_URL must remain the stable public origin,
# NOT the Vercel preview hostname. Otherwise OAuth/MCP resource binding breaks.

NODE_ENV=production
LOG_LEVEL=info
CSRF_ENABLED=true
OAUTH_DCR_ENABLED=false
TEST_CENTER_ENABLED=false

DEPLOYMENT_ROLE=canary
IS_DEPLOYMENT_ROUTER=false

# Must match production public URL:
# APP_URL=https://mcpcontroller.vercel.app
# API_URL=https://mcpcontroller.vercel.app

# Shared with production (same values):
# MONGODB_URI=
# JWT_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional label for observability headers on the preview deployment:
# DEPLOYMENT_VERSION=canary-test-v2
