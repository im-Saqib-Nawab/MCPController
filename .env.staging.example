# Staging overrides. Copy to .env.staging on the staging host or set in your platform dashboard.
NODE_ENV=staging
LOG_LEVEL=info
CSRF_ENABLED=true
OAUTH_DCR_ENABLED=false
TEST_CENTER_ENABLED=false

# Required in staging (same as production):
# MONGODB_URI=
# APP_URL=
# API_URL=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# JWT_SECRET=

# Set only for temporary staging bootstraps. Remove once real secrets are configured.
# STAGING_ALLOW_WEAK_SECRETS=false
