# Production overrides. Copy to .env.production on the production host or set in your platform dashboard.
# On Vercel: Project -> Settings -> Environment Variables (Production), then redeploy.
NODE_ENV=production
LOG_LEVEL=info
CSRF_ENABLED=true
OAUTH_DCR_ENABLED=false
TEST_CENTER_ENABLED=false

# Optional production error tracking (recommended):
# SENTRY_DSN=

# Required in production (API returns 503 until all are set in Vercel):
# MONGODB_URI=               # MongoDB Atlas connection string; allow 0.0.0.0/0 in Atlas Network Access
# APP_URL=https://your-app.vercel.app
# API_URL=https://your-app.vercel.app
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=            # minimum 12 characters, not a common default
# JWT_SECRET=                # unique strong value, not a development default
#
# Recommended (secures /metrics in production):
# METRICS_TOKEN=             # bearer token for /metrics and /api/metrics
#
# Deployment / canary routing (production router only):
# IS_DEPLOYMENT_ROUTER=true  # default on production; preview deployments are targets automatically
# DEPLOYMENT_ROLE=router     # router | canary
# DEPLOYMENT_VERSION=v1      # optional label; defaults to Vercel git SHA
# CANARY_URL_ALLOWLIST=*.vercel.app
# DEPLOYMENT_ROLLOUT_CACHE_TTL_MS=5000
